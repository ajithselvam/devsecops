# Backend environment. Copy to backend/.env and fill in.
# backend/.env is git-ignored because it holds the InsForge service key.

NODE_ENV=development
PORT=3001

# ── InsForge (server-side) ─────────────────────────────────────────────────────
# Service key: never expose this to the browser. Rotate with
#   npx @insforge/cli secret set
INSFORGE_URL=https://i5zui5j2.us-east.insforge.app
INSFORGE_PROJECT_ID=
INSFORGE_API_KEY=
# Safe to ship to the browser; needed for client-side auth only.
INSFORGE_ANON_KEY=

# Access tokens are RS256. Get the public key with:
#   npx @insforge/cli secret get --project-id <id> --name INSFORGE_JWT_PUBLIC_KEY
# Paste it as a single quoted value, newlines included.
INSFORGE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# Unused since InsForge replaced local JWT auth, kept for compatibility.
INSFORGE_JWT_SECRET=

# Private buckets created by migrations/20260926180408_add-storage-rls.sql.
INSFORGE_LOG_BUCKET=log-files
INSFORGE_ARTIFACT_BUCKET=scan-artifacts

# ── Legacy ────────────────────────────────────────────────────────────────────
# Unused now that Prisma/SQLite has been replaced by InsForge Postgres.
DATABASE_URL=file:./dev.db

DOCKER_HOST=unix:///var/run/docker.sock

REDIS_HOST=
REDIS_PORT=

AI_OMNIROUTE_URL=
AI_OMNIROUTE_KEY=
AI_OMNIROUTE_MODEL=
AI_FREE_AI_URL=https://api.free.ai/v1/chat/
AI_FREE_AI_KEY=sk-free-replace-me
AI_FREE_AI_MODEL=qwen7b

# Google Apps Script web app that bridges to OpenRouter. This is the fallback that
# works from hosted environments, where neither free.ai nor a local OmniRoute
# server is reachable. The bridge must be a web app deployed with "Anyone" access
# and its doGet must accept ?prompt= (see appscript-function.txt).
AI_APPS_SCRIPT_URL=

# Pin the provider that leads the failover chain (freeai | omniroute | apps_script).
# Leave empty for auto-preference: free.ai, then OmniRoute, then Apps Script.
AI_DEFAULT_PROVIDER=

# Optional. Comma-separated providers to try straight after the default one.
# Unregistered names are ignored. Unset = the remaining providers in the
# auto-preference order above.
# Example: AI_PROVIDER_ORDER=apps_script,omniroute
AI_PROVIDER_ORDER=

# How long to wait on the Apps Script bridge (ms). Free models are slow and the
# bridge adds a cold start, so this is generous by default.
AI_APPS_SCRIPT_TIMEOUT_MS=180000
